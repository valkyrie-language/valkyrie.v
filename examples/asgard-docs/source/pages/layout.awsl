<widget layout>
<div class="docs-layout">
    <header class="docs-header">
        <a class="docs-logo" href="/">Asgard Docs</a>
        <nav class="docs-header-nav">
            <Link href="/docs/getting-started">文档</Link>
            <Link href="/components">组件</Link>
            <Link href="/tutorial">教程</Link>
            <Link href="/api">API</Link>
        </nav>
    </header>

    <div class="docs-body">
        <aside class="docs-sidebar">
            <loop section in sections>
                <div class="docs-sidebar-group">
                    <div class="docs-sidebar-title">{section.icon} {section.title}</div>
                    <loop page in section.pages>
                        <Link :href=""/docs/" + section.id + "/" + page.id"
                        @class="docs-sidebar-link {isActive('/docs/' + section.id + '/' + page.id) ? 'active' : ''}">
                        {page.title}
                    </Link>
                </loop>
            </div>
        </loop>
    </aside>

    <main class="docs-content">
        <slot />
    </main>
</div>

<footer class="docs-footer">
    <p>© 2027 Asgard — 使用 Asgard 自身构建 🐶</p>
</footer>
</div>
</widget>

<script>
let sections = get_doc_sections()

micro isActive(path: utf8): bool {
    return __voa_get_current_path__() == path
}
</script>

<style>
.docs-layout {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    background: var(--asgard-bg);
    color: var(--asgard-text);
}
.docs-header {
    background: var(--asgard-card);
    border-bottom: 1px solid var(--asgard-border);
    padding: 12px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: sticky;
    top: 0;
    z-index: 50;
}
.docs-logo {
    font-size: 18px;
    font-weight: 800;
    color: var(--asgard-text);
    text-decoration: none;
}
.docs-header-nav {
    display: flex;
    gap: 20px;
}
.docs-header-nav a {
    color: var(--asgard-text-secondary);
    text-decoration: none;
    font-size: 14px;
}
.docs-header-nav a:hover { color: var(--asgard-text); }
.docs-header-nav a.active { color: var(--asgard-accent); font-weight: 600; }
.docs-body {
    display: flex;
    flex: 1;
}
.docs-sidebar {
    width: 240px;
    flex-shrink: 0;
    padding: 20px 16px;
    border-right: 1px solid var(--asgard-border);
    overflow-y: auto;
    position: sticky;
    top: 52px;
    height: calc(100vh - 52px);
}
.docs-sidebar-group { margin-bottom: 20px; }
.docs-sidebar-title {
    font-size: 12px;
    font-weight: 700;
    color: var(--asgard-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 6px;
}
.docs-sidebar-link {
    display: block;
    padding: 5px 10px;
    border-radius: var(--asgard-radius-sm);
    color: var(--asgard-text-secondary);
    text-decoration: none;
    font-size: 13px;
    transition: all var(--asgard-transition-fast);
}
.docs-sidebar-link:hover { background: var(--asgard-hover); color: var(--asgard-text); }
.docs-sidebar-link.active { background: var(--asgard-accent-subtle); color: var(--asgard-accent); font-weight: 600; }
.docs-content {
    flex: 1;
    padding: 32px 40px;
    max-width: 800px;
    min-width: 0;
}
.docs-footer {
    text-align: center;
    padding: 16px;
    color: var(--asgard-text-tertiary);
    font-size: 12px;
    border-top: 1px solid var(--asgard-border);
}
</style>
