{
    name: "container.oci",
    version: "workspace",
    description: "OCI image-spec 规范化落地：spec 字段校验、schema 细节；通用类型复用 container 包",
    type: "library",
    dependencies: {
        "std": { version: "workspace" },
        "std.data": { version: "workspace" },
        "std.data.digest": { version: "workspace" },
        "container": { version: "workspace" }
    },
    build: [
        { target: "ovm" },
        { target: "clr" },
        { target: "jvm" },
        { target: "wasm" }
    ]
}
