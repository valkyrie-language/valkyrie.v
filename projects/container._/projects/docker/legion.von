{
    name: "container.docker",
    version: "workspace",
    description: "Docker 复刻：Dockerfile 解析、层构建；核心类型复用 container 包",
    type: "library",
    dependencies: {
        "std": { version: "workspace" },
        "std.data": { version: "workspace" },
        "std.data.digest": { version: "workspace" },
        "container": { version: "workspace" }
    },
    build: [
        { target: "ovm" },
        { target: "clr" },
        { target: "jvm" },
        { target: "wasm" }
    ]
}
