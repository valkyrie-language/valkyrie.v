{
    name: "atlas",
    version: "workspace",
    description: "Atlas 后端框架核心 — Domain Adapter Pattern（DAP）的 Valkyrie 实现",
    type: "library",
    dependencies: { "std": { version: "workspace" } },
    build: [
        {
            target: "ovm"
        },
        {
            target: "clr-microsoft-unknown-managed",
            msil: true
        }
    ],
    targets: {
        "atlas-serve": {
            description: "启动 Atlas 监听（见 atlas.tools serve）"
        }
    }
}
