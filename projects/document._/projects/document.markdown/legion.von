{
    name: "document.markdown",
    version: "workspace",
    description: "document.* markdown subset: parse to the document model and orchestrate HTML with embedded mermaid and TeX (Valkyrie)",
    type: "library",
    dependencies: { "std": { version: "workspace" }, "document": { version: "workspace" }, "document.render": { version: "workspace" }, "document.mermaid": { version: "workspace" }, "vutex": { version: "workspace" } },
    build: [
        {
            target: "ovm"
        }
    ]
}
