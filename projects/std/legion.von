{
    name: "std",
    version: "2020.0.0.0",
    description: "Valkyrie 标准库 -- 跨平台统一接口, 编译时分发到各平台 SDK",
    auto_link: {
        core: true,
        std: false
    },
    dependencies: {},
    build: [
        {
            target: "nyar"
        },
        {
            target: "clr-microsoft-unknown-managed",
            msil: true
        },
        {
            target: "jvm-openjdk-unknown-managed"
        },
        {
            target: "wasm32-unknown-browser-wasm",
            source_map: true,
            typescript: true,
            wat: true
        },
        {
            target: "wasm32-node-unknown-wasm"
        }
    ],
    engines: {
        vcc: "0.1.*"
    }
}
