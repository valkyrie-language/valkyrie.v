{
    name: "std.data.binary.wasm",
    version: "workspace",
    description: "WASM 二进制编解码 — decode/encode .wasm",
    type: "library",
    dependencies: { "std": { version: "workspace" }
    },
    build: [
        { target: "ovm" },
        { target: "clr" },
        { target: "jvm" },
        { target: "wasm" }
    ]
}