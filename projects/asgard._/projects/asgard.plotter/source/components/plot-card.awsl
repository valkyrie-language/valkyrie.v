<widget plot_card>
<div>
    <if title != ''>
        <header slot="header">
            <h3 slot="title">{title}</h3>
            <if subtitle != ''>
                <p slot="subtitle">{subtitle}</p>
            </if>
        </header>
    </if>
    <div slot="body">
        <div :style="f\"width: {width}\"">
            {svg_html}
        </div>
    </div>
    <if footer != ''>
        <footer slot="footer">{footer}</footer>
    </if>
</div>
</widget>

<script>
let title: utf8 = ""
let subtitle: utf8 = ""
let footer: utf8 = ""
let svg_html: utf8 = ""
let width: utf8 = "100%"
let variant: utf8 = "bordered"
</script>

<style>
root { direction: vertical; radius: 8; background: @panel; color: @ink }
slot header { inset: 12 }
slot title { text: @body; color: @ink }
slot subtitle { text: @caption; color: @ink-muted }
slot body { inset: 12 }
slot footer { inset: 8; text: @caption; color: @ink-muted }
</style>
