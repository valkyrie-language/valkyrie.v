<widget interactive_col_plot>
<div>
    <if title != ''>
        <h3 slot="title">{title}</h3>
    </if>
    <div slot="legend" role="group" aria-label="图例">
        <loop item in series>
            <button
                type="button"
                slot="legend-item"
                @click="toggle(item.key)"
            >
                <span slot="swatch" :style="'background: ' + item.fill"></span>
                <span>{item.label}</span>
            </button>
        </loop>
</div>
<div slot="canvas">
    <div slot="plot" role="img" :aria-label="title">
        <loop item in series>
            <div slot="col">
                <button
                    type="button"
                    slot="bar"
                    :style="'height: ' + item.height_pct + '%; background: ' + item.fill"
                    @click="pin(item.key)"
                    :aria-label="item.label"
                ></button>
                <span slot="xlabel">{item.label}</span>
            </div>
        </loop>
    </div>
    <if tooltip_visible>
        <div slot="tooltip">
            <div slot="tooltip-label">{tooltip_label}</div>
            <div slot="tooltip-value">{tooltip_value}</div>
            <div slot="tooltip-hint">点击柱体锁定 · 再点取消</div>
        </div>
    </if>
</div>
</div>
</widget>

<script>
let title: utf8 = ""
let series: list = []
let mut active_key: utf8 = ""
let mut pinned_key: utf8 = ""
let mut hidden_key: utf8 = ""
let mut tooltip_label: utf8 = ""
let mut tooltip_value: utf8 = ""
let mut tooltip_visible: bool = false

micro toggle(key: utf8) {
    if hidden_key == key {
        hidden_key = ""
    } else {
    hidden_key = key
    if pinned_key == key {
        pinned_key = ""
        tooltip_visible = false
    }
if active_key == key {
    active_key = ""
}
}
}

micro pin(key: utf8) {
    if pinned_key == key {
        pinned_key = ""
        active_key = ""
        tooltip_visible = false
        tooltip_label = ""
        tooltip_value = ""
        return
    }
pinned_key = key
active_key = key
tooltip_visible = true
tooltip_label = key
tooltip_value = key
let mut index: usize = 0
while index < series.length() {
    let item = series⁅index⁆
    if item.key == key {
        tooltip_label = item.label
        tooltip_value = item.value_text
    }
index = index + 1
}
}
</script>

<style>
root { direction: vertical; spacing: 10; color: @ink }
slot title { text: @caption; color: @ink }
slot legend { direction: horizontal; spacing: 12 }
slot legend-item { direction: horizontal; cross-align: center; spacing: 6; inset: 2; radius: 8; background: @panel-hover; color: @ink; text: @caption }
slot swatch { width: 10; height: 10; radius: 2; background: @brand }
slot canvas { direction: vertical; spacing: 8; inset: 12; radius: 8; background: @surface }
slot plot { direction: horizontal; cross-align: stretch; spacing: 8; inset: 12; height: 220 }
slot col { direction: vertical; cross-align: center; spacing: 6; width: fill }
slot bar { width: fill; background: @brand; radius: 2 }
slot xlabel { text: @caption; color: @ink-muted }
slot tooltip { direction: vertical; spacing: 2; inset: 8; radius: 8; width: 160; background: @surface; color: @ink; text: @caption }
slot tooltip-label { text: @caption; color: @ink }
slot tooltip-value { text: @caption; color: @ink-soft }
slot tooltip-hint { text: @caption; color: @ink-muted }
</style>
