<widget plot_grid>
<div>
    <loop item in items>
        <div slot="cell">
            <if item.title != ''>
                <h4 slot="cell-title">{item.title}</h4>
            </if>
            <div>{item.svg_html}</div>
        </div>
    </loop>
</div>
</widget>

<script>
let columns: utf8 = "2"
let items: list = []
</script>

<style>
root { direction: horizontal; spacing: 16 }
slot cell { direction: vertical; spacing: 8; width: fill; inset: 12; radius: 8; background: @surface }
slot cell-title { text: @caption; color: @ink }
</style>
