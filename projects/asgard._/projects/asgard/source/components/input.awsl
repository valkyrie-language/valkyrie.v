<widget input>
<div class="asgard-input-wrapper">
    <if label>
        <label class="asgard-input-label">{label}</label>
        <else/>
    </if>
    <input
    @class="asgard-input {size}"
    :type="type"
    :placeholder="placeholder"
    :value="value"
    @input="handleInput"
    @focus="handleFocus"
    @blur="handleBlur"
    :disabled="disabled"
    />
    <if error>
        <span class="asgard-input-error">{error}</span>
        <else/>
    </if>
</div>
</widget>

<script>
let label: utf8 = ""
let type: utf8 = "text"
let placeholder: utf8 = ""
let mut value: utf8 = ""
let size: utf8 = "medium"
let disabled: bool = false
let error: utf8 = ""

micro handleInput(e: InputEvent) {
    value = e.target.value
    emit("input", { value: value })
}

micro handleFocus() {
    emit("focus", {})
}

micro handleBlur() {
    emit("blur", {})
}
</script>

<style>
.asgard-input-wrapper {
    display: flex;
    flex-direction: column;
    gap: 4px;
}
.asgard-input-label {
    font-size: 13px;
    color: var(--asgard-text2, #8b949e);
}
.asgard-input {
    padding: 8px 12px;
    border: 1px solid var(--asgard-border, #333);
    border-radius: 6px;
    background: var(--asgard-bg, #0d1117);
    color: var(--asgard-text, #e0e0e0);
    font-size: 14px;
    outline: none;
    transition: border-color 0.2s;
}
.asgard-input:focus {
    border-color: var(--asgard-accent, #58a6ff);
}
.asgard-input.small {
    padding: 4px 8px;
    font-size: 12px;
}
.asgard-input.large {
    padding: 12px 16px;
    font-size: 16px;
}
.asgard-input[disabled] {
    opacity: 0.5;
    cursor: not-allowed;
}
.asgard-input-error {
    font-size: 12px;
    color: #da3633;
}
</style>
