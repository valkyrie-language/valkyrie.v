<widget modal>
<div @class="asgard-modal-overlay {open ? 'visible' : ''}" @click="handleOverlayClick">
    <div @class="asgard-modal {size}">
        <div class="asgard-modal-header">
            <h3 class="asgard-modal-title">{title}</h3>
            <button class="asgard-modal-close" @click="close">✕</button>
        </div>
        <div class="asgard-modal-body">
            {children}
        </div>
        <if showFooter>
            <div class="asgard-modal-footer">
                <slot name="footer" />
            </div>
            <else/>
        </if>
    </div>
</div>
</widget>

<script>
let title: utf8 = ""
let mut open: bool = false
let size: utf8 = "medium"
let showFooter: bool = true
let closeOnOverlay: bool = true

micro close() {
    open = false
    emit("close", {})
}

micro handleOverlayClick(e: MouseEvent) {
    if closeOnOverlay && dom_class_list_contains(e.target.classList, "asgard-modal-overlay") {
        close()
    }
}
</script>

<style>
.asgard-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s;
}
.asgard-modal-overlay.visible {
    opacity: 1;
    pointer-events: auto;
}
.asgard-modal {
    background: var(--asgard-card, #161b22);
    border: 1px solid var(--asgard-border, #21262d);
    border-radius: 12px;
    max-height: 80vh;
    display: flex;
    flex-direction: column;
}
.asgard-modal.small {
    width: 400px;
}
.asgard-modal.medium {
    width: 560px;
}
.asgard-modal.large {
    width: 720px;
}
.asgard-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    border-bottom: 1px solid var(--asgard-border, #21262d);
}
.asgard-modal-title {
    margin: 0;
    font-size: 16px;
    font-weight: 600;
    color: var(--asgard-text, #e6edf3);
}
.asgard-modal-close {
    border: none;
    background: none;
    color: var(--asgard-text2, #8b949e);
    font-size: 18px;
    cursor: pointer;
    padding: 4px 8px;
    border-radius: 4px;
}
.asgard-modal-close:hover {
    background: var(--asgard-hover, #2a2a3e);
    color: var(--asgard-text, #e6edf3);
}
.asgard-modal-body {
    padding: 20px;
    overflow-y: auto;
    flex: 1;
}
.asgard-modal-footer {
    padding: 12px 20px;
    border-top: 1px solid var(--asgard-border, #21262d);
    display: flex;
    justify-content: flex-end;
    gap: 8px;
}
</style>
