<widget button>
<div class="asgard-btn-wrapper">
    <button @class="asgard-btn {variant}" @click="handleClick" :disabled="disabled">
        {label}
    </button>
</div>
</widget>

<script>
let label: utf8 = "Button"
let variant: utf8 = "default"
let disabled: bool = false

micro handleClick() {
    if !disabled {
        emit("click", {})
    }
}
</script>

<style>
.asgard-btn-wrapper {
    display: inline-block;
}
.asgard-btn {
    padding: 8px 16px;
    border: 1px solid var(--asgard-border, #333);
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    background: var(--asgard-card, #1a1a2e);
    color: var(--asgard-text, #e0e0e0);
    transition: all 0.2s;
}
.asgard-btn:hover {
    background: var(--asgard-hover, #2a2a3e);
    border-color: var(--asgard-accent, #58a6ff);
}
.asgard-btn.primary {
    background: var(--asgard-accent, #58a6ff);
    color: #fff;
    border-color: var(--asgard-accent, #58a6ff);
}
.asgard-btn.primary:hover {
    opacity: 0.9;
}
.asgard-btn.danger {
    background: #da3633;
    color: #fff;
    border-color: #da3633;
}
.asgard-btn[disabled] {
    opacity: 0.5;
    cursor: not-allowed;
}
</style>
