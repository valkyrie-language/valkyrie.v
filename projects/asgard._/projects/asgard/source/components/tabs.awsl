<widget tabs>
<div class="asgard-tabs">
    <div class="asgard-tab-bar">
        <loop tab in {tabs}>
            <button
            @class="asgard-tab {activeTab == tab.key ? 'active' : ''}"
            @click="() => setActive(tab.key)"
            :disabled="tab.disabled"
            >
            <if tab.icon>
                <span class="asgard-tab-icon">{tab.icon}</span>
                <else/>
            </if>
            {tab.label}
        </button>
    </loop>
</div>
<div class="asgard-tab-content">
    <slot :name="activeTab" />
</div>
</div>
</widget>

<script>
let tabs: list = []
let mut activeTab: utf8 = ""

micro setActive(key) {
    activeTab = key
    emit("change", { key: key })
}
</script>

<style>
.asgard-tabs {
    display: flex;
    flex-direction: column;
}
.asgard-tab-bar {
    display: flex;
    border-bottom: 1px solid var(--asgard-border, #21262d);
    gap: 0;
}
.asgard-tab {
    padding: 10px 16px;
    border: none;
    background: none;
    color: var(--asgard-text2, #8b949e);
    font-size: 14px;
    cursor: pointer;
    border-bottom: 2px solid transparent;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    gap: 6px;
}
.asgard-tab:hover {
    color: var(--asgard-text, #e6edf3);
    background: var(--asgard-hover, #161b22);
}
.asgard-tab.active {
    color: var(--asgard-accent, #58a6ff);
    border-bottom-color: var(--asgard-accent, #58a6ff);
}
.asgard-tab[disabled] {
    opacity: 0.4;
    cursor: not-allowed;
}
.asgard-tab-icon {
    font-size: 16px;
}
.asgard-tab-content {
    padding: 16px 0;
}
</style>
