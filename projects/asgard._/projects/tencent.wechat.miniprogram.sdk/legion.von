{
    name: "tencent.wechat.miniprogram.sdk",
    description: "腾讯 WeChat 小程序 SDK -- 微信小程序宿主 API 绑定",
    dependencies: {
        "core": "workspace",
        "std": "workspace"
    },
    sdk_vendor: {
        organization: "tencent",
        host: "wechat",
        kind: "platform-sdk",
        targets: ["wechat"],
        publish: ["mini-program"]
    },
    build: [
        {
            target: "wechat",
            source_map: true,
            typescript: true,
            wat: true
        }
    ],
    engines: {
        vcc: "0.1.*"
    }
}
