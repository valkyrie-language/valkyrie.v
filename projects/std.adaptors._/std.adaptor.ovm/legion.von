{
    name: "std.adaptor.ovm",
    description: "Valkyrie OVM 平台 SDK — OVM 指令集绑定",
    dependencies: {
        "core": "workspace",
        "std": "workspace"
    },
    sdk_vendor: {
        organization: "valkyrie",
        host: "ovm",
        kind: "distribution-default",
        targets: ["ovm"]
    },
    build: [
        {
            target: "ovm"
        }
    ],
    engines: {
        vcc: "0.1.*"
    }
}
