{
    name: "std.adaptor.nyar",
    description: "Valkyrie NyarVM 平台 SDK — NyarVM 指令集绑定",
    dependencies: {
        "core": "workspace",
        "std": "workspace"
    },
    sdk_vendor: {
        organization: "valkyrie",
        host: "nyar",
        kind: "distribution-default",
        targets: ["nyar"]
    },
    build: [
        {
            target: "nyar"
        }
    ],
    engines: {
        vcc: "0.1.*"
    }
}
