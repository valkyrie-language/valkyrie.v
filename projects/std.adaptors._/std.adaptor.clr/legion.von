{
    name: "std.adaptor.clr",
    description: "Valkyrie CLR 适配器 -- .NET CLR 运行时 API 绑定（System.* 链接）",
    dependencies: {
        "core": "workspace",
        "std": "workspace"
    },
    sdk_vendor: {
        organization: "valkyrie",
        host: "clr",
        kind: "distribution-default",
        targets: ["clr-microsoft-unknown-managed"]
    },
    engines: {
        vcc: "0.1.*"
    },
    os: {
        target: "windows"
    },
    build: [
        {
            target: "clr-microsoft-unknown-managed",
            msil: true
        }
    ],
    cpu: {
        arch: "clr"
    }
}
