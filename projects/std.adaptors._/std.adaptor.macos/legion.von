{
    name: "std.adaptor.macos",
    description: "Valkyrie macOS SDK -- macOS 平台 API 绑定",
    dependencies: {
        "core": "workspace",
        "std": "workspace"
    },
    sdk_vendor: {
        organization: "valkyrie",
        host: "macos",
        kind: "distribution-default",
        targets: ["aarch64-apple-darwin"]
    },
    build: [
        {
            target: "ovm"
        }
    ],
    engines: {
        vcc: "0.1.*"
    }
}
