{
    name: "std.adaptor.wasm",
    description: "Valkyrie WebAssembly SDK -- Web 浏览器 API 绑定",
    dependencies: {
        "core": "workspace",
        "std": "workspace"
    },
    sdk_vendor: {
        organization: "valkyrie",
        host: "browser",
        kind: "distribution-default",
        targets: [
            "node",
            "wasm32-unknown-browser-wasm",
            "wasm32-node-unknown-wasm"
        ]
    },
    build: [
        {
            target: "wasm32-unknown-browser-wasm",
            source_map: true,
            typescript: true,
            wat: true
        },
        {
            target: "wechat"
        }
    ],
    engines: {
        vcc: "0.1.*"
    }
}
